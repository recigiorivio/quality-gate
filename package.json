{
  "name": "qualidade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tela local para ver o diff das tarefas, e as ferramentas de qualidade do workspace",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.mjs",
    "checagens": "node ferramentas/checar-diff.mjs",
    "autoteste": "node ferramentas/checar-diff.mjs --autoteste",
    "contexto": "node ferramentas/contexto.mjs",
    "indices": "node ferramentas/indices.mjs",
    "log": "node ferramentas/log.mjs",
    "banco": "node --disable-warning=ExperimentalWarning ferramentas/banco.mjs",
    "test": "D=$(mktemp -d) && trap \"rm -rf $D\" EXIT INT TERM && QUALIDADE_ESTADO=$D node --disable-warning=ExperimentalWarning --test teste/*.mjs",
    "tela": "playwright test",
    "tela-ui": "playwright test --ui",
    "tudo": "npm test && npm run tela"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
