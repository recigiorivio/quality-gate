.env
node_modules/

# saída dos testes de tela: screenshot e trace de caso que falhou
test-results/
playwright-report/
relatorios/
gate.log
servico.log
*.local
*.bak

# estado local, não código: nº de PR, nomes de repo, achados internos
ocultos.json
pontos-atencao.json
bases.json
regras.json
LOCAL.md
linear.json
linear-cache.json
comparacoes.json

# log das corridas do agente: estado local
corridas/

# dump de `banco.mjs exportar`: é o MESMO conteúdo local do banco, em JSON
exportado/

# token sorteado da exposição na rede: segredo local
token.local

# repos escolhidos para a implantação: estado local
implantacao.json

# catálogo de repos e pares de branches: nomes de repo do workspace de quem roda
repos.json

# o banco tem o MESMO conteúdo local que os JSONs acima (nº de PR, nomes de repo, achados
# internos). O -wal e o -shm são companhia obrigatória do arquivo principal.
qualidade.db
qualidade.db-wal
qualidade.db-shm
